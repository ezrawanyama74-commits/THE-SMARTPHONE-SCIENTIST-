<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Authentication | Smartphone Scientist</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body style="display: flex; align-items: center; justify-content: center; min-height: 100vh;">

    <div class="form-card" style="width: 100%; max-width: 400px; padding: 30px;">
        <div style="text-align: center; margin-bottom: 25px;">
            <i class="fa-solid fa-shield-halved" style="font-size: 2.5rem; color: var(--accent-green); margin-bottom: 10px;"></i>
            <h1 style="font-family: var(--font-code); font-size: 1.2rem; color: #fff;">SMARTPHONE SCIENTIST</h1>
            <span style="font-family: var(--font-code); font-size: 0.75rem; color: var(--text-muted);">AUTHENTICATION REQUIRED</span>
        </div>

        <% if (error) { %>
            <div style="background: rgba(255, 71, 87, 0.15); border: 1px solid var(--danger-red); color: var(--danger-red); padding: 10px; border-radius: 6px; font-size: 0.8rem; margin-bottom: 15px; font-family: var(--font-code);">
                <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label>Scientist Identifier</label>
                <input type="text" name="username" class="form-input" required autocomplete="off" placeholder="e.g. scientist">
            </div>

            <div class="form-group">
                <label>Security Passcode</label>
                <input type="password" name="password" class="form-input" required>
            </div>

            <button type="submit" class="btn-submit" style="margin-top: 10px;">
                <i class="fa-solid fa-key"></i> Authenticate
            </button>
        </form>
    </div>

</body>
</html>
