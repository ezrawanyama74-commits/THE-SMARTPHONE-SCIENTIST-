    <script>
        // Interactive "See More" clamping controller handler
        document.addEventListener('click', function(e) {
            if (e.target && e.target.classList.contains('see-more-btn')) {
                const body = e.target.previousElementSibling;
                body.classList.toggle('expanded');
                if (body.classList.contains('expanded')) {
                    e.target.innerText = 'See Less';
                } else {
                    e.target.innerText = 'See More...';
                    window.scrollTo({ top: body.parentElement.offsetTop - 20, behavior: 'smooth' });
                }
            }
        });
    </script>
</body>
</html>
