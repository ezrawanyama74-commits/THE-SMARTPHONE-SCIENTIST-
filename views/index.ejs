    <title>Ezra Wanyama | THE SMARTPHONE SCIENTIST</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <div class="profile-container">
            <img src="%PROFILE_IMAGE%" alt="Avatar" class="profile-avatar" onerror="this.style.opacity='0';">
        </div>
        <h1 class="site-title">Ezra Wanyama</h1>
        <div><p class="site-subtitle">THE SMARTPHONE SCIENTIST</p></div>
        <div class="manifesto-box">
            <p class="manifesto-quote">"They told me a smartphone was just for consuming content. I proved it's a supercomputer for creating it. Built line-by-line in a mobile terminal, this platform is proof that when you possess knowledge, hardware is no longer a barrier."</p>
        </div>
        <a href="#content-feed" class="cta-scroll-btn">See the Grit</a>
    </header>

    <main id="content-feed" class="feed-container">
        %STORIES_STREAM%
    </main>

